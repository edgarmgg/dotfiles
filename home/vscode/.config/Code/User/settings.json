{
  "explorer.confirmDelete": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "code-runner.runInTerminal": true,
  "explorer.confirmDragAndDrop": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "jutge-vscode.problem.preferredLang": "English",
  "code-runner.executorMap": {
    "cpp": "cd \"$dir\" && g++ -std=c++17 -Wall -Wextra -Wpedantic -Wshadow -Wconversion -g \"$fileName\" -o \"$fileNameWithoutExt\" && \"./$fileNameWithoutExt\""
  },
  "code-runner.saveFileBeforeRun": true,
  "editor.formatOnSave": true,
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 2 }",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.compilerPath": "/usr/bin/g++",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "onFocusChange",
  "git.autofetch": true,
  "git.confirmSync": false,
  "makefile.configureOnOpen": true,
  "editor.renderWhitespace": "trailing",
  "workbench.colorCustomizations": {
    "editorWhitespace.foreground": "#8b949e66"
  }
}
