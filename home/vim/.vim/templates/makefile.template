CXX      := g++
CXXFLAGS := -std=c++17 -Wall -Wextra -pedantic
TARGET   := $(notdir $(CURDIR))
SRCS     := $(wildcard *.cc)
HDRS     := $(wildcard *.h)

all: $(TARGET)

$(TARGET): $(SRCS) $(HDRS)
	$(CXX) $(CXXFLAGS) -o $@ $(SRCS)

clean:
	rm -f $(TARGET)

.PHONY: all clean
