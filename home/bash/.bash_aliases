alias update='sudo pacman -Syu'
alias autoremove='sudo pacman -Rns $(pacman -Qdtq)'
alias vpnstatus='pgrep -x openfortivpn >/dev/null && echo "VPN conectada" || echo "VPN desconectada"'
alias vpnoff='nmcli -t -f NAME connection show --active | grep -qx ULL-VPN && nmcli connection down ULL-VPN || sudo pkill -x openfortivpn'
alias g++='g++ -std=c++17 -Wall -Wextra -Wpedantic -Wshadow -Wconversion'
