{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "arch", "color": { "1": "38;2;69;174;224", "2": "38;2;69;174;224" }, "padding": { "right": 2 } },
  "display": { "separator": "  ", "color": { "keys": "38;2;69;174;224", "output": "white" } },
  "modules": [
    { "type": "os",       "key": " OS" },
    { "type": "host",     "key": " Host" },
    { "type": "kernel",   "key": " Kernel" },
    { "type": "uptime",   "key": " Uptime" },
    { "type": "packages", "key": " Packages" },
    { "type": "shell",    "key": " Shell" },
    { "type": "display",  "key": " Display", "format": "{width}x{height} @ {refresh-rate} Hz" },
    { "type": "wm",       "key": " WM" },
    { "type": "cpu",      "key": " CPU", "format": "{name} @ {freq-max}" },
    { "type": "gpu",      "key": " GPU", "format": "{name}" },
    { "type": "memory",   "key": " Memory" },
    { "type": "swap",     "key": " Swap" },
    { "type": "disk",     "key": " Disk", "folders": "/:/mnt", "format": "{mountpoint} {size-used} / {size-total} ({size-percentage})" },
    { "type": "battery",  "key": " Battery", "format": "{capacity} [{status}]" },
    { "type": "colors",   "symbol": "circle", "paddingLeft": 2 }
  ]
}
